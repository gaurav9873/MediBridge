# Copy this file to .env and adjust as needed.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database (matches docker-compose.yml)
# ---------------------------------------------------------------------------
# Owner role. Migrations, the seed and tooling only — it may run DDL.
DATABASE_URL="postgresql://medibridge:medibridge_dev@localhost:5433/medibridge?schema=public"
# The running API uses this one. It is NOT a superuser and does NOT have
# BYPASSRLS, which is what makes Row-Level Security actually apply. The API
# refuses to start if this role can bypass RLS.
APP_DATABASE_URL="postgresql://medibridge_app:medibridge_app_dev@localhost:5433/medibridge?schema=public"

# ---------------------------------------------------------------------------
# Redis — port 6380 because Homebrew Redis already owns 6379 on this machine
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6380"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV="development"
API_PORT=4100
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:3100"

# ---------------------------------------------------------------------------
# Auth — replace both secrets before any deployment
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4100/api/v1"
NEXT_PUBLIC_APP_NAME="MediBridge B2B"

# ---------------------------------------------------------------------------
# Multi-tenancy
#
# Leave both blank for local development: requests then resolve their tenant
# from the signed-in session, which is all a single-machine setup needs.
# ---------------------------------------------------------------------------
# Suffix stripped by the subdomain strategy: abcpharma.medibridge.in
TENANT_BASE_DOMAIN=""
# Single-tenant deployment: the one company every request belongs to.
# Which tenant a request belongs to when nothing else says. On localhost
# there is no subdomain or custom domain to read, so without this a
# sign-up cannot tell which store it is joining.
DEFAULT_TENANT_SLUG="medibridge"

# ---------------------------------------------------------------------------
# Business rules — seeded into the Setting table, editable later from Admin
# ---------------------------------------------------------------------------
DEFAULT_DELIVERY_RADIUS_KM=25
DEFAULT_TOKEN_PERCENT=20
DEFAULT_SAME_DAY_CUTOFF="14:00"

# ---------------------------------------------------------------------------
# Integrations — left blank in MVP scaffold, wired in Phase 5+
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
AWS_S3_BUCKET=""
AWS_REGION="ap-south-1"
