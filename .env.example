# Copy this file to .env and adjust as needed.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database (matches docker-compose.yml)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://medibridge:medibridge_dev@localhost:5432/medibridge?schema=public"

# ---------------------------------------------------------------------------
# Redis — port 6380 because Homebrew Redis already owns 6379 on this machine
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6380"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV="development"
API_PORT=4000
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# Auth — replace both secrets before any deployment
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_NAME="MediBridge B2B"

# ---------------------------------------------------------------------------
# Business rules — seeded into the Setting table, editable later from Admin
# ---------------------------------------------------------------------------
DEFAULT_DELIVERY_RADIUS_KM=25
DEFAULT_TOKEN_PERCENT=20
DEFAULT_SAME_DAY_CUTOFF="14:00"

# ---------------------------------------------------------------------------
# Integrations — left blank in MVP scaffold, wired in Phase 5+
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
AWS_S3_BUCKET=""
AWS_REGION="ap-south-1"
