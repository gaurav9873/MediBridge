// MediBridge B2B — database schema
//
// Conventions used throughout:
//   * Money is ALWAYS an Int of paise. Never Float, never Decimal-as-rupees.
//     100 paise = ₹1. See packages/types/src/money.ts.
//   * Enums mirror packages/types/src/enums.ts exactly. Change both together.
//   * Geography lives on Address.location, a GENERATED column derived from
//     latitude/longitude and indexed with GiST. It powers ST_DWithin for the
//     Same-Day delivery radius. See migration 0001 for the raw SQL.
//   * Order lines snapshot the medicine name, batch and price at purchase time
//     so an edit to the catalogue can never rewrite someone's order history.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// Prisma 7 no longer accepts `url` here — the connection string lives in
// prisma.config.ts for the CLI, and reaches the client through a driver adapter.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  RETAILER
  DISTRIBUTOR
  ADMIN
  DELIVERY
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}

enum DocumentType {
  DRUG_LICENSE
  GST_CERTIFICATE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Schedule X is blocked platform-wide in the MVP — it carries record-keeping
/// duties (Form 2C register, duplicate prescriptions) we are not building yet.
enum DrugSchedule {
  NONE
  H
  H1
  X
}

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  OINTMENT
  CREAM
  DROPS
  POWDER
  INHALER
  SPRAY
  GEL
  SACHET
  OTHER
}

enum SaleUnit {
  STRIP
  BOX
  BOTTLE
  VIAL
  TUBE
  PIECE
  PACK
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  ACCEPTED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
  REJECTED
  RETURNED
}

enum DeliveryMode {
  SAME_DAY
  NEXT_DAY
}

enum DeliveryStatus {
  NOT_STARTED
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum PaymentType {
  TOKEN
  BALANCE
  REFUND
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  CASH
}

enum PaymentGateway {
  RAZORPAY
  CASHFREE
  MANUAL
}

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
  IN_APP
}

enum NotificationEvent {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_PACKED
  ORDER_DISPATCHED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  REFUND_INITIATED
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  LICENSE_EXPIRING
  LICENSE_EXPIRED
  LOW_STOCK
  BATCH_EXPIRING
  NEW_ORDER_RECEIVED
  SETTLEMENT_PAID
}

enum MedicineRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProblemCategory {
  MISSING_ITEM
  DAMAGED
  WRONG_ITEM
  EXPIRY_TOO_SOON
  OTHER
}

enum ProblemStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId     String?       @db.Uuid
  companyRef    Company?      @relation("UserCompany", fields: [companyId], references: [id])
  id            String        @id @default(uuid()) @db.Uuid
  /// Primary sign-in identifier. Stored as bare 10 digits, no +91.
  phone         String        @unique @db.VarChar(10)
  email         String        @unique @db.VarChar(255)
  passwordHash  String        @db.VarChar(255)
  fullName      String        @db.VarChar(120)
  role          UserRole
  accountStatus AccountStatus @default(PENDING_VERIFICATION)

  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  /// Set by an admin when pausing an account. Shown to support, not the user.
  suspensionReason String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete — orders and invoices must survive an account closure.
  deletedAt DateTime?

  addresses          Address[]
  documents          Document[]
  refreshTokens      RefreshToken[]
  challenges         VerificationChallenge[]
  cart               Cart?
  orderGroups        OrderGroup[]
  retailerOrders     Order[]                  @relation("RetailerOrders")
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  auditLogs          AuditLog[]               @relation("AuditActor")
  reviewedDocuments  Document[]               @relation("DocumentReviewer")
  statusChanges      OrderStatusHistory[]
  reportedProblems   ProblemReport[]          @relation("ProblemReporter")
  resolvedProblems   ProblemReport[]          @relation("ProblemResolver")
  medicineRequests   MedicineRequest[]        @relation("MedicineRequester")
  reviewedRequests   MedicineRequest[]        @relation("MedicineRequestReviewer")
  createdMedicines   Medicine[]               @relation("MedicineCreator")
  stockTransfers     StockTransfer[]          @relation("StockTransferActor")
  updatedSettings    Setting[]
  initiatedRefunds   Refund[]
  bulkJobs           BulkJob[]
  /// One per distributor this buyer trades with. A list rather than a single
  /// row since the same shop may hold relationships with several.
  customerProfiles   Customer[]
  roleAssignments    UserRoleAssignment[]
  identities         UserIdentity[]

  @@index([role, accountStatus])
  @@index([deletedAt])
  @@map("users")
}

/// Uploaded drug licences and GST certificates, plus their approval trail.
model Document {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId  String?      @db.Uuid
  companyRef Company?     @relation("DocumentCompany", fields: [companyId], references: [id])
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  type       DocumentType
  /// Licence or GST number as printed on the document.
  number     String       @db.VarChar(60)
  /// Only drug licences expire.
  expiresOn  DateTime?    @db.Date

  /// S3 object key. Never a public URL — these are served via signed links.
  fileKey   String @db.VarChar(500)
  fileName  String @db.VarChar(255)
  mimeType  String @db.VarChar(100)
  sizeBytes Int

  verificationStatus VerificationStatus @default(PENDING)
  reviewedById       String?            @db.Uuid
  reviewedAt         DateTime?
  /// Shown verbatim to the user, so it must be written in plain English.
  rejectionReason    String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("DocumentReviewer", fields: [reviewedById], references: [id])

  /// The same licence number must not appear on two accounts.
  @@unique([type, number])
  @@index([verificationStatus, createdAt])
  @@index([userId, type])
  @@map("documents")
}

model Address {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId  String?  @db.Uuid
  companyRef Company? @relation("AddressCompany", fields: [companyId], references: [id])
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid

  label        String  @db.VarChar(40)
  line1        String  @db.VarChar(200)
  line2        String? @db.VarChar(200)
  city         String  @db.VarChar(80)
  state        String  @db.VarChar(80)
  pincode      String  @db.VarChar(6)
  contactPhone String  @db.VarChar(10)

  /// Source of truth for position. `location` below is derived from these.
  latitude  Float
  longitude Float

  /// GENERATED ALWAYS column: ST_SetSRID(ST_MakePoint(longitude, latitude), 4326).
  /// Created in migration 0001 and indexed with GiST. Prisma cannot read this
  /// type, which is fine — only raw ST_DWithin queries touch it.
  location Unsupported("geography(Point, 4326)")?

  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderGroups   OrderGroup[]
  orders        Order[]
  warehouses    Warehouse[]

  @@index([userId, isDefault])
  @@index([pincode])
  @@map("addresses")
}

/// Rotating refresh tokens. Kept in Postgres rather than Redis so that
/// "sign out everywhere" and session auditing survive a cache flush.
/// A short-lived code sent out of band: OTP sign-in, phone confirmation,
/// password reset. One table because all three are the same rule — prove you
/// control an identifier, once, within a few minutes. See ChallengePurpose.
///
/// No companyId, and therefore no RLS: a challenge is issued before anyone
/// knows which tenant the request belongs to, exactly like user_identities.
model VerificationChallenge {
  id String @id @default(uuid()) @db.Uuid

  /// Matches ChallengePurpose in @medibridge/types. A reset code cannot be
  /// spent to sign in, because verification always names the purpose it wants.
  purpose String @db.VarChar(30)
  /// The mobile number or email the code went to.
  identifier String @db.VarChar(255)
  /// SHA-256 of the six digits. The code itself is never stored, so a database
  /// leak does not hand over live codes.
  codeHash String @db.VarChar(64)

  expiresAt DateTime
  /// Wrong guesses so far. The challenge dies at CHALLENGE_MAX_ATTEMPTS,
  /// which is what stops a brute force of the 10^6 space.
  attempts   Int       @default(0)
  /// Set the moment it is spent. Single use is enforced here, not by deletion,
  /// so a replayed code is distinguishable from an expired one.
  consumedAt DateTime?

  /// Known for reset and re-verification; null when signing up, because the
  /// user does not exist yet.
  userId    String? @db.Uuid
  ipAddress String? @db.VarChar(45)

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The lookup every verification does: newest live challenge for this
  /// identifier and purpose.
  @@index([purpose, identifier, consumedAt])
  @@index([expiresAt])
  @@map("verification_challenges")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  /// SHA-256 of the token. The token itself is never stored.
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime

  revokedAt           DateTime?
  /// Set when this token is rotated, so a replayed old token is detectable.
  replacedByTokenHash String?   @db.VarChar(64)

  userAgent String? @db.VarChar(400)
  ipAddress String? @db.VarChar(45)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// Admin-owned master list. Distributors map their stock onto these rows, which
/// is what makes cross-distributor price comparison possible — without it,
/// "Crocin 500" and "crocin 500mg" become two unrelated products.
model Medicine {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId    String?      @db.Uuid
  companyRef   Company?     @relation("MedicineCompany", fields: [companyId], references: [id])
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(200)
  brand        String       @db.VarChar(120)
  /// Active salt. Retailers search by this at least as often as by brand.
  composition  String       @db.VarChar(300)
  form         MedicineForm
  strength     String?      @db.VarChar(60)
  packSize     String?      @db.VarChar(60)
  manufacturer String?      @db.VarChar(160)

  hsnCode String @db.VarChar(8)
  /// Whole percentage: 0, 5, 12 or 18.
  gstRate Int    @default(12)

  schedule               DrugSchedule @default(NONE)
  isPrescriptionRequired Boolean      @default(false)
  /// Set false to delist. Schedule X rows are forced false by the service layer.
  isActive               Boolean      @default(true)

  /// GENERATED tsvector over name/brand/composition, GIN-indexed in migration
  /// 0001. Weighted A/B/C so a brand-name hit outranks a composition hit.
  searchVector Unsupported("tsvector")?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy      User?             @relation("MedicineCreator", fields: [createdById], references: [id])
  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  requests       MedicineRequest[]
  offers         MedicineOffer[]
  stockTransfers StockTransfer[]

  @@unique([name, brand, strength, packSize])
  @@index([isActive, schedule])
  @@index([composition])
  @@map("medicines")
}

/// A distributor asking for a medicine that is missing from the master list.
model MedicineRequest {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId     String                @db.Uuid
  companyRef    Company               @relation("MedicineRequestCompany", fields: [companyId], references: [id])
  id            String                @id @default(uuid()) @db.Uuid
  requestedById String                @db.Uuid
  name          String                @db.VarChar(200)
  brand         String                @db.VarChar(120)
  composition   String?               @db.VarChar(300)
  form          MedicineForm?
  strength      String?               @db.VarChar(60)
  notes         String?               @db.Text
  status        MedicineRequestStatus @default(PENDING)

  reviewedById    String?   @db.Uuid
  reviewedAt      DateTime?
  rejectionReason String?   @db.Text
  /// Populated when the request is approved and the medicine created.
  medicineId      String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestedBy User      @relation("MedicineRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewer    User?     @relation("MedicineRequestReviewer", fields: [reviewedById], references: [id])
  medicine    Medicine? @relation(fields: [medicineId], references: [id])

  @@index([status, createdAt])
  @@map("medicine_requests")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

/// One BATCH of one medicine held by one distributor.
///
/// Batch-level tracking is not optional in pharma: every unit sold must carry a
/// batch number and expiry, and stock is picked oldest-expiry-first (FEFO).
model InventoryItem {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId     String  @db.Uuid
  companyRef    Company @relation("InventoryItemCompany", fields: [companyId], references: [id])
  id          String  @id @default(uuid()) @db.Uuid
  warehouseId String  @db.Uuid
  medicineId  String  @db.Uuid

  batchNumber String   @db.VarChar(60)
  expiryDate  DateTime @db.Date

  mrpPaise          Int
  /// Set by the distributor. Enforced <= mrpPaise by a CHECK constraint.
  sellingPricePaise Int

  /// Physical stock on the shelf.
  quantity          Int      @default(0)
  /// Held for carts mid-checkout. Available = quantity - reservedQuantity.
  reservedQuantity  Int      @default(0)
  unit              SaleUnit @default(STRIP)
  minOrderQuantity  Int      @default(1)
  lowStockThreshold Int      @default(10)

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  medicine     Medicine           @relation(fields: [medicineId], references: [id])
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reservations StockReservation[]

  @@unique([warehouseId, medicineId, batchNumber])
  /// Covers the hot search path: live stock for a medicine, oldest expiry first.
  @@index([medicineId, isActive, expiryDate])
  @@index([warehouseId, isActive])
  @@index([expiryDate])
  @@map("inventory_items")
}

/// A short-lived hold on stock while a retailer completes payment.
///
/// Created inside the same transaction that takes a row lock on the inventory
/// item, and swept by a background job once `expiresAt` passes.
model StockReservation {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId       String  @db.Uuid
  companyRef      Company @relation("StockReservationCompany", fields: [companyId], references: [id])
  id              String  @id @default(uuid()) @db.Uuid
  inventoryItemId String  @db.Uuid
  quantity        Int

  /// Set once the reservation is attached to a real order.
  orderId String? @db.Uuid
  /// Before an order exists, the reservation belongs to a cart.
  cartId  String? @db.Uuid

  expiresAt  DateTime
  releasedAt DateTime?
  consumedAt DateTime?

  createdAt DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([expiresAt, releasedAt, consumedAt])
  @@index([inventoryItemId])
  @@index([cartId])
  @@map("stock_reservations")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

/// Server-authoritative cart. Prices are always re-read from inventory at
/// checkout — `addedAtPricePaise` exists only to detect and explain a change.
model Cart {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId  String   @db.Uuid
  companyRef Company  @relation("CartCompany", fields: [companyId], references: [id])
  id         String   @id @default(uuid()) @db.Uuid
  retailerId String   @unique @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  retailer User       @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId       String  @db.Uuid
  companyRef      Company @relation("CartItemCompany", fields: [companyId], references: [id])
  id              String  @id @default(uuid()) @db.Uuid
  cartId          String  @db.Uuid
  inventoryItemId String  @db.Uuid
  quantity        Int

  /// The price the retailer saw when adding this. Compared at checkout.
  addedAtPricePaise Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart          Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([cartId, inventoryItemId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

/// One checkout. A cart spanning several distributors produces ONE group and
/// several Orders — the retailer pays once, each distributor fulfils separately.
model OrderGroup {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId   String  @db.Uuid
  companyRef  Company @relation("OrderGroupCompany", fields: [companyId], references: [id])
  id          String  @id @default(uuid()) @db.Uuid
  /// Human-facing, e.g. "MB-2026-000123".
  groupNumber String  @unique @db.VarChar(24)
  retailerId  String  @db.Uuid
  addressId   String  @db.Uuid

  totalPaise   Int
  tokenPaise   Int
  balancePaise Int
  /// Snapshotted from Setting at checkout, so changing the platform rate later
  /// never rewrites what an existing order asked for.
  tokenPercent Int

  notes String? @db.Text

  /// Rejects a double-tapped checkout button.
  idempotencyKey String @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  retailer User      @relation(fields: [retailerId], references: [id])
  address  Address   @relation(fields: [addressId], references: [id])
  orders   Order[]
  payments Payment[]

  @@index([retailerId, createdAt])
  @@map("order_groups")
}

model Order {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId    String  @db.Uuid
  companyRef   Company @relation("OrderCompany", fields: [companyId], references: [id])
  id           String  @id @default(uuid()) @db.Uuid
  orderNumber  String  @unique @db.VarChar(24)
  orderGroupId String  @db.Uuid

  retailerId  String @db.Uuid
  /// The buyer's relationship with `companyId`, resolved when the order is
  /// created rather than inferred afterwards. Once a shop can buy from several
  /// distributors, "which customer is this?" has more than one answer unless
  /// the order records the one it was placed under — and credit limits and
  /// payment terms hang off that answer.
  customerId  String @db.Uuid
  warehouseId String @db.Uuid
  addressId   String @db.Uuid

  status       OrderStatus  @default(PENDING_PAYMENT)
  deliveryMode DeliveryMode

  subtotalPaise       Int
  gstPaise            Int
  deliveryChargePaise Int @default(0)
  totalPaise          Int
  tokenPaise          Int
  balancePaise        Int
  tokenPercent        Int

  /// Distance from distributor hub to delivery address, in km, at order time.
  /// Stored because the radius setting can change afterwards and we need to
  /// justify why this order was offered Same-Day.
  distanceKm Float?

  expectedDeliveryAt DateTime?
  acceptedAt         DateTime?
  packedAt           DateTime?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?

  cancellationReason String? @db.Text
  rejectionReason    String? @db.Text
  notes              String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderGroup      OrderGroup           @relation(fields: [orderGroupId], references: [id])
  retailer        User                 @relation("RetailerOrders", fields: [retailerId], references: [id])
  customer        Customer             @relation(fields: [customerId], references: [id])
  warehouse       Warehouse            @relation("WarehouseOrders", fields: [warehouseId], references: [id])
  address         Address              @relation(fields: [addressId], references: [id])
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  refunds         Refund[]
  delivery        Delivery?
  problems        ProblemReport[]
  settlementItems SettlementItem[]

  @@index([retailerId, status, createdAt])
  @@index([customerId, status, createdAt])
  @@index([warehouseId, status, createdAt])
  @@index([status, createdAt])
  @@index([orderGroupId])
  @@map("orders")
}

/// A line on an order.
///
/// Everything a receipt needs is snapshotted here. If the catalogue is edited
/// or a distributor changes their price tomorrow, this row still shows what was
/// actually bought and at what price.
model OrderItem {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId       String  @db.Uuid
  companyRef      Company @relation("OrderItemCompany", fields: [companyId], references: [id])
  id              String  @id @default(uuid()) @db.Uuid
  orderId         String  @db.Uuid
  inventoryItemId String  @db.Uuid
  medicineId      String  @db.Uuid

  // --- snapshot at purchase time ---
  medicineName String   @db.VarChar(200)
  brand        String   @db.VarChar(120)
  composition  String   @db.VarChar(300)
  batchNumber  String   @db.VarChar(60)
  expiryDate   DateTime @db.Date
  unit         SaleUnit
  hsnCode      String   @db.VarChar(8)
  gstRate      Int

  orderedQuantity  Int
  /// Set when a distributor can only supply part of the line. Null until then.
  acceptedQuantity Int?

  mrpPaise          Int
  unitPricePaise    Int
  lineSubtotalPaise Int
  lineGstPaise      Int
  lineTotalPaise    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  medicine      Medicine      @relation(fields: [medicineId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

/// Append-only status trail. Drives the progress timeline the retailer sees.
model OrderStatusHistory {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId   String       @db.Uuid
  companyRef  Company      @relation("OrderStatusHistoryCompany", fields: [companyId], references: [id])
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?      @db.Uuid
  reason      String?      @db.Text
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId    String  @db.Uuid
  companyRef   Company @relation("PaymentCompany", fields: [companyId], references: [id])
  id           String  @id @default(uuid()) @db.Uuid
  /// TOKEN payments belong to the group (one payment covers the whole cart).
  orderGroupId String? @db.Uuid
  /// BALANCE payments are per order, collected in cash by each distributor.
  orderId      String? @db.Uuid

  type    PaymentType
  status  PaymentStatus  @default(PENDING)
  method  PaymentMethod?
  gateway PaymentGateway @default(RAZORPAY)

  amountPaise         Int
  refundedAmountPaise Int @default(0)

  gatewayOrderId   String? @db.VarChar(120)
  /// Unique so a replayed webhook cannot double-credit a payment.
  gatewayPaymentId String? @unique @db.VarChar(120)
  gatewaySignature String? @db.VarChar(255)

  failureReason String? @db.Text
  /// Raw gateway webhook body, kept verbatim for reconciliation disputes.
  rawPayload    Json?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orderGroup OrderGroup? @relation(fields: [orderGroupId], references: [id])
  order      Order?      @relation(fields: [orderId], references: [id])
  refunds    Refund[]

  @@index([orderGroupId])
  @@index([orderId])
  @@index([status, createdAt])
  @@index([gatewayOrderId])
  @@map("payments")
}

model Refund {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId  String  @db.Uuid
  companyRef Company @relation("RefundCompany", fields: [companyId], references: [id])
  id         String  @id @default(uuid()) @db.Uuid
  paymentId  String  @db.Uuid
  orderId    String  @db.Uuid

  amountPaise Int
  reason      String        @db.Text
  status      PaymentStatus @default(PENDING)

  gatewayRefundId String? @unique @db.VarChar(120)
  /// Null for automatic refunds (cancel before dispatch); set when an admin
  /// approves a post-dispatch refund by hand.
  initiatedById   String? @db.Uuid

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payment     Payment @relation(fields: [paymentId], references: [id])
  order       Order   @relation(fields: [orderId], references: [id])
  initiatedBy User?   @relation(fields: [initiatedById], references: [id])

  @@index([orderId])
  @@index([status, createdAt])
  @@map("refunds")
}

/// Weekly payout of collected token money to a distributor, minus platform fee.
model Settlement {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId     String  @db.Uuid
  companyRef    Company @relation("SettlementCompany", fields: [companyId], references: [id])
  id String @id @default(uuid()) @db.Uuid

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  grossPaise       Int
  platformFeePaise Int
  netPayablePaise  Int

  status        SettlementStatus @default(PENDING)
  /// Bank reference for the transfer, shown to the distributor once paid.
  utrNumber     String?          @db.VarChar(40)
  paidAt        DateTime?
  failureReason String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SettlementItem[]

  @@unique([companyId, periodStart, periodEnd])
  @@index([status, periodEnd])
  @@map("settlements")
}

model SettlementItem {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId    String  @db.Uuid
  companyRef   Company @relation("SettlementItemCompany", fields: [companyId], references: [id])
  id           String  @id @default(uuid()) @db.Uuid
  settlementId String  @db.Uuid
  orderId      String  @db.Uuid

  grossPaise       Int
  platformFeePaise Int
  netPaise         Int

  createdAt DateTime @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id])

  @@unique([settlementId, orderId])
  @@map("settlement_items")
}

// ---------------------------------------------------------------------------
// Delivery
// ---------------------------------------------------------------------------

/// In the MVP the distributor delivers with their own people. MediBridge tracks
/// status and verifies the handover with a 4-digit code the retailer reads out.
model Delivery {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId  String  @db.Uuid
  companyRef Company @relation("DeliveryCompany", fields: [companyId], references: [id])
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @unique @db.Uuid

  status DeliveryStatus @default(NOT_STARTED)
  mode   DeliveryMode

  deliveryPersonName  String? @db.VarChar(120)
  deliveryPersonPhone String? @db.VarChar(10)

  /// SHA-256 of the 4-digit code. The code itself is only ever shown to the
  /// retailer in their app and never stored in the clear.
  otpHash     String? @db.VarChar(64)
  otpAttempts Int     @default(0)

  assignedAt       DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  failedAt         DateTime?
  failureReason    String?   @db.Text

  /// What the delivery person actually collected. Reconciled against the
  /// order's balancePaise.
  cashCollectedPaise Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("deliveries")
}

model ProblemReport {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId    String          @db.Uuid
  companyRef   Company         @relation("ProblemReportCompany", fields: [companyId], references: [id])
  id           String          @id @default(uuid()) @db.Uuid
  orderId      String          @db.Uuid
  reportedById String          @db.Uuid
  category     ProblemCategory
  description  String          @db.Text
  status       ProblemStatus   @default(OPEN)

  resolvedById String?   @db.Uuid
  resolvedAt   DateTime?
  resolution   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reportedBy User  @relation("ProblemReporter", fields: [reportedById], references: [id])
  resolvedBy User? @relation("ProblemResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@index([orderId])
  @@map("problem_reports")
}

// ---------------------------------------------------------------------------
// Notifications, settings, audit
// ---------------------------------------------------------------------------

model Notification {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId  String?             @db.Uuid
  companyRef Company?            @relation("NotificationCompany", fields: [companyId], references: [id])
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  event      NotificationEvent
  channel    NotificationChannel

  title   String @db.VarChar(200)
  body    String @db.Text
  /// Deep-link target and template variables.
  payload Json?

  readAt        DateTime?
  sentAt        DateTime?
  failedAt      DateTime?
  failureReason String?   @db.Text

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([event, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId  String?             @db.Uuid
  companyRef Company?            @relation("NotificationPreferenceCompany", fields: [companyId], references: [id])
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  event      NotificationEvent
  channel    NotificationChannel
  enabled    Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, event, channel])
  @@map("notification_preferences")
}

/// Platform-wide business rules, editable from the Admin panel.
/// Nothing in this table should ever need a code deploy to change.
model Setting {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId   String?  @db.Uuid
  companyRef  Company? @relation("SettingCompany", fields: [companyId], references: [id])
  key         String   @id @db.VarChar(80)
  value       Json
  /// Plain-English explanation shown next to the field in Admin.
  description String   @db.Text
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("settings")
}

model AuditLog {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId  String?  @db.Uuid
  companyRef Company? @relation("AuditLogCompany", fields: [companyId], references: [id])
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(60)
  entityId   String   @db.VarChar(64)

  before Json?
  after  Json?

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(400)

  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Bulk operations
//
// One engine serves every module. See docs/BULK-OPERATIONS.md.
// ---------------------------------------------------------------------------

enum BulkJobType {
  MEDICINE_IMPORT
  INVENTORY_IMPORT
  INVENTORY_STOCK_UPDATE
  INVENTORY_PRICE_UPDATE
  INVENTORY_EXPIRY_UPDATE
  INVENTORY_STATUS_UPDATE
  USER_IMPORT
}

enum BulkJobStatus {
  PENDING
  VALIDATING
  /// Dry run finished; nothing written yet, waiting on the user.
  AWAITING_CONFIRMATION
  IMPORTING
  PAUSED
  COMPLETED
  /// Finished, but some rows were skipped. The error file lists them.
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

/// One import run, from upload to report.
///
/// Doubles as the progress record (the worker updates processedRows each
/// batch), the resume checkpoint, and the import-history row.
model BulkJob {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId  String        @db.Uuid
  companyRef Company       @relation("BulkJobCompany", fields: [companyId], references: [id])
  id         String        @id @default(uuid()) @db.Uuid
  type       BulkJobType
  status     BulkJobStatus @default(PENDING)

  createdById String  @db.Uuid
  /// Distributor jobs are scoped to their own inventory. Null for admin jobs.
  /// Always taken from the session, never from the uploaded file.
  scopeId     String? @db.Uuid

  fileKey   String @db.VarChar(500)
  fileName  String @db.VarChar(255)
  sizeBytes Int

  /// Null until the file has been counted during validation.
  totalRows     Int?
  /// Also the resume checkpoint: on resume the worker skips rows up to here.
  processedRows Int  @default(0)

  createCount     Int     @default(0)
  updateCount     Int     @default(0)
  skipCount       Int     @default(0)
  errorCount      Int     @default(0)
  /// Set when the recorded-error cap is reached.
  errorsTruncated Boolean @default(false)

  /// Failed rows in template format plus an Error column, so the user can fix
  /// and re-upload the same file unchanged.
  errorFileKey  String? @db.VarChar(500)
  /// Row-by-row outcome of the apply pass.
  resultFileKey String? @db.VarChar(500)

  /// Handler-specific options, e.g. { dryRun: true }.
  options Json?

  failureReason String?   @db.Text
  queuedAt      DateTime  @default(now())
  validatedAt   DateTime?
  confirmedAt   DateTime?
  finishedAt    DateTime?
  updatedAt     DateTime  @updatedAt

  createdBy User           @relation(fields: [createdById], references: [id])
  errors    BulkJobError[]

  @@index([createdById, queuedAt])
  @@index([type, status])
  @@index([status, queuedAt])
  @@map("bulk_jobs")
}

model BulkJobError {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId  String  @db.Uuid
  companyRef Company @relation("BulkJobErrorCompany", fields: [companyId], references: [id])
  id         String  @id @default(uuid()) @db.Uuid
  jobId      String  @db.Uuid
  rowNumber  Int
  column     String? @db.VarChar(80)
  value      String? @db.VarChar(500)
  message    String  @db.Text
  /// The original row, so the error file can be rebuilt without re-reading
  /// the upload — and so the row survives even if the upload is purged.
  rawRow     Json?

  createdAt DateTime @default(now())

  job BulkJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, rowNumber])
  @@map("bulk_job_errors")
}

/// Search read model — one row per (medicine, distributor) with the best
/// sellable offer. See migration 20260806120000_medicine_offers.
///
/// Maintained entirely by database triggers on inventory_items and medicines,
/// so application code never writes here. Reading it replaces a four-table
/// join plus aggregation with a single index-ordered scan.
model MedicineOffer {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId     String  @db.Uuid
  companyRef    Company @relation("MedicineOfferCompany", fields: [companyId], references: [id])
  medicineId  String  @db.Uuid
  warehouseId String  @db.Uuid

  bestPricePaise   Int
  mrpPaise         Int
  totalAvailable   Int
  latestExpiry     DateTime @db.Date
  minOrderQuantity Int

  // Denormalised from Medicine so search needs no join.
  name        String       @db.VarChar(200)
  brand       String       @db.VarChar(120)
  composition String       @db.VarChar(300)
  form        MedicineForm
  schedule    DrugSchedule

  /// Copied from Medicine.searchVector by the trigger.
  searchVector Unsupported("tsvector")

  updatedAt DateTime @default(now())

  medicine  Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([medicineId, warehouseId])
  @@map("medicine_offers")
}

// ---------------------------------------------------------------------------
// Multi-tenancy
//
// A private distributor portal is a marketplace with exactly one seller, so
// both business models share these tables. What differs is only how many
// companies a customer may buy from. See docs/MULTI-TENANCY.md.
// ---------------------------------------------------------------------------

enum BusinessMode {
  MARKETPLACE
  PRIVATE_DISTRIBUTOR
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PaymentTermType {
  TOKEN_PLUS_COD
  PREPAID
  COD
  CREDIT
}

/// A tenant. Every business row in the database belongs to one of these, and
/// PostgreSQL Row-Level Security enforces that — see the RLS migration.
model Company {
  id     String        @id @default(uuid()) @db.Uuid
  name   String        @db.VarChar(160)
  /// Subdomain label: portal.<slug>.medibridge.in
  slug   String        @unique @db.VarChar(63)
  status CompanyStatus @default(TRIAL)

  /// Decides how many sellers this company's customers can buy from, and
  /// therefore which capabilities are even meaningful.
  businessMode BusinessMode @default(PRIVATE_DISTRIBUTOR)

  gstNumber         String?   @db.VarChar(15)
  drugLicenseNumber String?   @db.VarChar(60)
  /// Denormalised from the approved DRUG_LICENSE document, so the ordering
  /// guard stays a single cheap read. A seller's licence lives here now that
  /// the seller is a company rather than a profile row.
  licenseExpiresOn  DateTime? @db.Date
  supportEmail      String?   @db.VarChar(255)
  supportPhone      String?   @db.VarChar(10)

  // --- white label ---
  logoUrl       String? @db.VarChar(500)
  /// One seed colour. The design tokens derive every surface and state from it,
  /// so a tenant cannot produce an unreadable palette.
  brandColor    String? @db.VarChar(9)
  loginImageUrl String? @db.VarChar(500)
  customDomain  String? @unique @db.VarChar(255)

  // --- business configuration, not platform rules ---
  /// Weekly settlement destination. Money settles to a company, not to a
  /// warehouse — a seller with three warehouses is still paid once.
  bankAccountHolder String? @db.VarChar(160)
  bankAccountNumber String? @db.VarChar(34)
  bankIfsc          String? @db.VarChar(11)

  paymentTermType PaymentTermType @default(TOKEN_PLUS_COD)
  /// TOKEN_PLUS_COD only.
  tokenPercent    Int             @default(20)
  /// CREDIT only.
  creditDays      Int             @default(30)

  planId      String?   @db.Uuid
  trialEndsOn DateTime? @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  plan          Plan?               @relation(fields: [planId], references: [id])
  warehouses     Warehouse[]
  customers      Customer[]
  stockTransfers StockTransfer[]
  roles         Role[]
  subscriptions Subscription[]
  overrides     CompanyCapability[]
  authMethods   CompanyAuthMethod[]
  /// Marketplace mode: the seller companies whose catalogue this portal shows.
  sellerLinks   CompanyLink[]       @relation("MarketplaceOperator")
  marketplaces  CompanyLink[]       @relation("SellerCompany")

  // Tenant-scoped data.
  users                   User[]                   @relation("UserCompany")
  documents               Document[]               @relation("DocumentCompany")
  addresss                Address[]                @relation("AddressCompany")
  medicines               Medicine[]               @relation("MedicineCompany")
  medicineRequests        MedicineRequest[]        @relation("MedicineRequestCompany")
  inventoryItems          InventoryItem[]          @relation("InventoryItemCompany")
  stockReservations       StockReservation[]       @relation("StockReservationCompany")
  carts                   Cart[]                   @relation("CartCompany")
  cartItems               CartItem[]               @relation("CartItemCompany")
  orderGroups             OrderGroup[]             @relation("OrderGroupCompany")
  orders                  Order[]                  @relation("OrderCompany")
  orderItems              OrderItem[]              @relation("OrderItemCompany")
  orderStatusHistorys     OrderStatusHistory[]     @relation("OrderStatusHistoryCompany")
  payments                Payment[]                @relation("PaymentCompany")
  refunds                 Refund[]                 @relation("RefundCompany")
  deliverys               Delivery[]               @relation("DeliveryCompany")
  problemReports          ProblemReport[]          @relation("ProblemReportCompany")
  notifications           Notification[]           @relation("NotificationCompany")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferenceCompany")
  settings                Setting[]                @relation("SettingCompany")
  auditLogs               AuditLog[]               @relation("AuditLogCompany")
  bulkJobs                BulkJob[]                @relation("BulkJobCompany")
  bulkJobErrors           BulkJobError[]           @relation("BulkJobErrorCompany")
  medicineOffers          MedicineOffer[]          @relation("MedicineOfferCompany")
  settlements             Settlement[]             @relation("SettlementCompany")
  settlementItems         SettlementItem[]         @relation("SettlementItemCompany")

  @@index([status, businessMode])
  @@index([deletedAt])
  @@map("companies")
}

/// Which sellers a marketplace shows. Empty for a private distributor, whose
/// customers buy only from the company itself.
model CompanyLink {
  id            String @id @default(uuid()) @db.Uuid
  marketplaceId String @db.Uuid
  sellerId      String @db.Uuid

  isActive      Boolean  @default(true)
  /// What the marketplace takes from each order, in basis points.
  commissionBps Int      @default(0)
  createdAt     DateTime @default(now())

  marketplace Company @relation("MarketplaceOperator", fields: [marketplaceId], references: [id], onDelete: Cascade)
  seller      Company @relation("SellerCompany", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([marketplaceId, sellerId])
  @@map("company_links")
}

/// Stock moved between two of one company's own warehouses.
///
/// A record rather than only an audit line, because "what moved last week?" is
/// a question a distributor asks their own data, and an AuditLog row is not
/// something you can filter a screen by.
///
/// Deliberately has no status: this records a move that has already happened
/// on the shelf, not one in transit. Tracking a lorry between two of your own
/// warehouses is a different feature with a different lifecycle, and inventing
/// its state machine here would be guessing at it.
model StockTransfer {
  /// Tenant this row belongs to. Enforced by Row-Level Security.
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  id              String @id @default(uuid()) @db.Uuid
  fromWarehouseId String @db.Uuid
  toWarehouseId   String @db.Uuid
  medicineId      String @db.Uuid

  /// Snapshotted, so the record still reads correctly if the batch is later
  /// removed from either warehouse.
  batchNumber String @db.VarChar(60)
  quantity    Int

  note           String? @db.Text
  transferredById String @db.Uuid

  createdAt DateTime @default(now())

  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  medicine      Medicine  @relation(fields: [medicineId], references: [id])
  transferredBy User      @relation("StockTransferActor", fields: [transferredById], references: [id])

  @@index([companyId, createdAt])
  @@index([medicineId, createdAt])
  @@map("stock_transfers")
}

/// A place a company ships from. Carries the geography, so the Same-Day radius
/// works identically in both business modes — it just picks the nearest
/// warehouse of whichever companies are sellable.
model Warehouse {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  name      String @db.VarChar(120)
  addressId String @db.Uuid

  sameDayRadiusKm        Int     @default(25)
  sameDayCutoffTime      String  @default("14:00") @db.VarChar(5)
  deliveryChargePaise    Int     @default(0)
  freeDeliveryAbovePaise Int?
  isAcceptingOrders      Boolean @default(true)
  isDefault              Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  address        Address         @relation(fields: [addressId], references: [id])
  inventoryItems InventoryItem[]
  orders         Order[]         @relation("WarehouseOrders")
  offers         MedicineOffer[]
  transfersOut   StockTransfer[] @relation("TransferFrom")
  transfersIn    StockTransfer[] @relation("TransferTo")

  @@index([companyId, isAcceptingOrders])
  @@map("warehouses")
}

/// A buyer. Belongs to exactly one company — the portal they signed up on.
/// In marketplace mode that company is the operator, and the customer may
/// order from any linked seller.
/// Where a buyer stands with one distributor.
///
/// Kept per relationship rather than on the buyer, because the same shop can
/// be in good standing with one distributor and suspended by another. A
/// suspended relationship is not a closed account — the row survives so the
/// order history it owns still resolves.
enum CustomerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

/// One buyer's trading relationship with one company.
///
/// This IS the join between a User and a Company — there is deliberately no
/// `Customer.parentId` and no separate CustomerCompany table. A shop buying
/// antibiotics from one stockist and surgical supplies from another gets one
/// row here per stockist, each with its own credit limit, payment terms and
/// standing.
///
/// `@@unique([companyId, userId])` rather than a unique `userId`: one buyer,
/// many distributors, but never two relationships with the same distributor.
model Customer {
  id           String  @id @default(uuid()) @db.Uuid
  companyId    String  @db.Uuid
  userId       String  @db.Uuid
  businessName String  @db.VarChar(160)
  gstNumber    String? @db.VarChar(15)

  drugLicenseNumber String?   @db.VarChar(60)
  licenseExpiresOn  DateTime? @db.Date

  /// Where this buyer stands with THIS distributor. See CustomerStatus.
  status     CustomerStatus @default(PENDING)
  /// When the distributor accepted the relationship. Null until they do.
  approvedAt DateTime?

  /// CREDIT terms only. Null means no credit allowed.
  creditLimitPaise Int?
  /// Overrides the company default for this customer.
  paymentTermType  PaymentTermType?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([companyId, userId])
  @@unique([companyId, gstNumber])
  @@index([companyId, deletedAt])
  @@index([userId, status])
  @@map("customers")
}

// --- roles and permissions ------------------------------------------------

/// Fixed roles ship in the MVP as seeded rows with isSystem = true. Custom
/// roles are the same table with isSystem = false, so enabling them later is a
/// UI change — the schema and the guards already support it.
model Role {
  id        String  @id @default(uuid()) @db.Uuid
  /// Null for platform-owner roles that belong to no company.
  companyId String? @db.Uuid
  /// Matches SystemRole in @medibridge/types for seeded roles.
  key       String  @db.VarChar(60)
  name      String  @db.VarChar(80)
  isSystem  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([companyId, key])
  @@map("roles")
}

model RolePermission {
  roleId     String @db.Uuid
  permission String @db.VarChar(60)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId String @db.Uuid
  roleId String @db.Uuid

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role_assignments")
}

// --- plans and capabilities -----------------------------------------------

model Plan {
  id            String  @id @default(uuid()) @db.Uuid
  key           String  @unique @db.VarChar(40)
  name          String  @db.VarChar(80)
  pricePaise    Int     @default(0)
  billingPeriod String  @default("MONTHLY") @db.VarChar(20)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  features      PlanFeature[]
  companies     Company[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanFeature {
  planId     String @db.Uuid
  capability String @db.VarChar(60)
  /// Numeric ceiling where the capability is quantitative, e.g. warehouses.
  limit      Int?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, capability])
  @@map("plan_features")
}

/// Per-company override, so a capability can be granted or revoked without
/// inventing a new plan for one customer.
model CompanyCapability {
  companyId  String  @db.Uuid
  capability String  @db.VarChar(60)
  enabled    Boolean
  limit      Int?
  note       String? @db.Text

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, capability])
  @@map("company_capabilities")
}

model Subscription {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  planId    String @db.Uuid

  status           String    @default("ACTIVE") @db.VarChar(20)
  currentPeriodEnd DateTime
  cancelledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([companyId, status])
  @@map("subscriptions")
}

/// One way a user can prove who they are.
///
/// Passwords used to live on User, which quietly assumed one login method
/// forever. A user now has many identities — a password today, Google
/// tomorrow, an SSO subject after that — and adding a method is a new row
/// type, not a schema change.
model UserIdentity {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  /// Matches AuthMethod in @medibridge/types.
  method String @db.VarChar(30)

  /// What the provider knows this user as: the mobile number, the email, the
  /// Google `sub`, the SSO subject. Unique per method.
  identifier String @db.VarChar(255)
  /// Argon2 hash for password methods; null for federated ones, where the
  /// identity provider holds the secret.
  secretHash String? @db.VarChar(255)

  /// The provider vouches for this identifier (a verified Google email).
  isVerified Boolean   @default(false)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([method, identifier])
  @@index([userId])
  @@map("user_identities")
}

/// Which sign-in methods a tenant offers, and their configuration.
/// One company may require SSO while another allows mobile + OTP.
model CompanyAuthMethod {
  companyId String @db.Uuid
  method    String @db.VarChar(30)
  isEnabled Boolean @default(true)
  /// Provider settings: OIDC issuer, client id, allowed email domains.
  config    Json?

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, method])
  @@map("company_auth_methods")
}
